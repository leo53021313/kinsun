# TTS 服務啟動設定範本（CosyVoice 3，僅 DGX）
#
# 用法：複製本檔為 services/tts/.env.tts 並填入你 DGX 上的實際路徑。
#   cp services/tts/.env.tts.example services/tts/.env.tts
# scripts/kinsun.sh start 會 source 此檔後才啟動 TTS；此檔不進版控（見 .gitignore）。
# 各變數意義見 services/tts/README.md。

# 指向 CosyVoice 環境的 Python（含 torch/torchaudio/soundfile 與 CosyVoice repo 依賴）。
# 例：TTS_PYTHON=/home/leo29/miniconda3/envs/cosyvoice/bin/python
TTS_PYTHON=python

# 模型 id 或本機權重目錄（本機優先、免下載）。
TTS_MODEL_ID=/abs/path/to/Fun-CosyVoice3-0.5B-2512

# CosyVoice repo 目錄（會被加入 sys.path），必填。
TTS_COSY_DIR=/abs/path/to/CosyVoice

# Matcha-TTS 目錄；留空＝{TTS_COSY_DIR}/third_party/Matcha-TTS。
TTS_MATCHA_DIR=

# 金孫參考語音（5–15 秒乾淨人聲）與其逐字稿，必填。
TTS_PROMPT_WAV=/abs/path/to/prompt.wav
TTS_PROMPT_TEXT=參考語音的逐字稿

# 設 1 於服務啟動即載入模型（預設 0＝延遲載入，首次請求才載）。
TTS_PRELOAD=1

# 長輩客製化參考音檔（聲音克隆）下載後的本機快取目錄；留空＝系統暫存目錄。
TTS_VOICE_CACHE_DIR=

# 最多同時快取幾位長輩的客製化參考音檔（FIFO 淘汰），預設 20。
TTS_VOICE_CACHE_SIZE=20
