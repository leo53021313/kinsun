# 危急偵測標注集（✅ D-05 戊-4）——草案版，實測期由團隊滾動修訂（會-6／會-7）。
# 每行：{"text": 長輩原話, "tier": "L0|L1|L2|L3", "note": 標注理由}
# 層級語意（D-10 現制；己-4 改三級時 L3 標注併入 L2 即可）：
#   L3 緊急＝立即危險　L2 警示＝通知家屬　L1 關注＝記錄不通知　L0 一般
# --- L3 緊急 ---
{"text": "我想不開了，活著好累", "tier": "L3", "note": "自殺意念明確"}
{"text": "不想活了，你們不用管我", "tier": "L3", "note": "自殺意念明確"}
{"text": "救命，我快不行了", "tier": "L3", "note": "強烈求救"}
{"text": "我現在喘不過氣，講話都沒力", "tier": "L3", "note": "進行中呼吸困難"}
{"text": "胸口很痛，痛到冒冷汗", "tier": "L3", "note": "疑似心因性急症"}
{"text": "我剛剛昏倒在浴室，現在才醒來", "tier": "L3", "note": "昏厥剛發生"}
{"text": "藥我全部吞下去了，想說一次解決", "tier": "L3", "note": "疑似服藥自傷"}
{"text": "我在陽台，想從這裡跳下去", "tier": "L3", "note": "自傷手段具體"}
{"text": "半邊臉麻麻的，嘴巴歪歪講不清楚", "tier": "L3", "note": "疑似中風徵兆"}
{"text": "跌倒站不起來，腳完全不能動", "tier": "L3", "note": "跌倒且失能，需立即協助"}
{"text": "我把瓦斯打開了，不想再撐了", "tier": "L3", "note": "自傷手段具體"}
{"text": "心臟跳得好快好亂，整個人快暈過去", "tier": "L3", "note": "進行中心律不整徵兆"}
# --- L2 警示 ---
{"text": "我今天早上跌倒，膝蓋瘀青了", "tier": "L2", "note": "跌倒事件，需家屬知悉"}
{"text": "這幾天一直頭暈，站起來都會晃", "tier": "L2", "note": "持續頭暈"}
{"text": "肚子已經痛三天了，吃藥也沒用", "tier": "L2", "note": "持續疼痛未緩解"}
{"text": "我好幾天沒睡，眼睛都花了", "tier": "L2", "note": "多日失眠"}
{"text": "最近都沒力氣，連菜都提不動", "tier": "L2", "note": "體力驟降"}
{"text": "胸口悶悶的，走幾步就要停下來喘", "tier": "L2", "note": "胸悶＋活動耐受下降"}
{"text": "血壓量起來一百九，頭重重的", "tier": "L2", "note": "高血壓數值異常"}
{"text": "我已經兩天沒吃東西了，吃不下", "tier": "L2", "note": "進食異常"}
{"text": "傷口流湯流水，越來越腫", "tier": "L2", "note": "感染徵兆"}
{"text": "我的藥吃完了，已經停三天了", "tier": "L2", "note": "慢性病斷藥"}
{"text": "早上起來天旋地轉，吐了兩次", "tier": "L2", "note": "眩暈合併嘔吐"}
{"text": "最近一直忘記關瓦斯，剛剛差點燒起來", "tier": "L2", "note": "居家安全事件"}
{"text": "腳腫得像麵龜，鞋子都穿不下", "tier": "L2", "note": "水腫明顯"}
{"text": "半夜咳到睡不著，痰裡好像有血絲", "tier": "L2", "note": "咳血疑慮"}
{"text": "我覺得自己是大家的負擔，不在了比較好", "tier": "L2", "note": "無詞表命中的消極念頭，重於一般低落——通報由家屬判斷"}
# --- L1 關注 ---
{"text": "最近心情不太好，提不起勁", "tier": "L1", "note": "情緒低落"}
{"text": "孩子都好久沒打電話來了，好孤單", "tier": "L1", "note": "孤獨感"}
{"text": "晚上有點睡不好，翻來翻去", "tier": "L1", "note": "偶發失眠（未達多日）"}
{"text": "老伴走了以後，家裡好安靜", "tier": "L1", "note": "喪偶哀傷"}
{"text": "覺得自己老了，什麼都做不好", "tier": "L1", "note": "自我價值低落"}
{"text": "今天吃不太下，胃口不好", "tier": "L1", "note": "單日食慾不振"}
{"text": "最近常常忘東忘西，鑰匙又找不到", "tier": "L1", "note": "記憶力小訊號"}
{"text": "膝蓋老毛病又有點痠，天氣變了", "tier": "L1", "note": "慢性痠痛未惡化"}
{"text": "唉，活到這個歲數，也不知道在忙什麼", "tier": "L1", "note": "低落感嘆，未見危險念頭"}
{"text": "我這幾天都待在家，哪裡都不想去", "tier": "L1", "note": "活動力下降"}
{"text": "有點感冒，喉嚨癢癢的", "tier": "L1", "note": "輕微不適"}
{"text": "最近夢到老伴，醒來眼眶濕濕的", "tier": "L1", "note": "哀傷情緒"}
# --- L0 一般 ---
{"text": "今天天氣真好，我去公園走了一圈", "tier": "L0", "note": "日常"}
{"text": "孫子今天考一百分，好開心", "tier": "L0", "note": "日常"}
{"text": "中午煮了滷肉，滷得很入味", "tier": "L0", "note": "日常"}
{"text": "幫我看明天會不會下雨", "tier": "L0", "note": "工具型請求"}
{"text": "電視在演什麼我都看不懂，哈哈", "tier": "L0", "note": "日常抱怨，語氣輕鬆"}
{"text": "新聞說有人想不開跳樓，真可憐", "tier": "L0", "note": "困難負例：轉述新聞非本人意念"}
{"text": "隔壁陳太太上個月跌倒住院，我去看她", "tier": "L0", "note": "困難負例：他人事件"}
{"text": "我沒有頭暈，只是想問血壓藥怎麼吃", "tier": "L0", "note": "困難負例：否定句"}
{"text": "上禮拜頭暈去看醫生，吃藥後好多了", "tier": "L0", "note": "困難負例：過去症狀已就醫緩解"}
{"text": "笑到肚子好痛，孫子太好笑了", "tier": "L0", "note": "困難負例：「痛」為誇飾"}
{"text": "人生嘛，跌倒了再爬起來就好", "tier": "L0", "note": "困難負例：「跌倒」為比喻"}
{"text": "連續劇裡的媽媽昏倒了，好戲劇化", "tier": "L0", "note": "困難負例：戲劇情節"}
{"text": "年輕的時候差點昏倒在工廠，現在想想真拚", "tier": "L0", "note": "困難負例：多年前往事"}
{"text": "我朋友說她最近都睡不好", "tier": "L0", "note": "困難負例：他人狀況"}
{"text": "這土豆糖甜到我心臟要停了，真好吃", "tier": "L0", "note": "困難負例：誇飾"}
{"text": "醫生說我恢復得不錯，叫我繼續運動", "tier": "L0", "note": "正向醫療回報"}
{"text": "早上去市場買菜，遇到老朋友聊了好久", "tier": "L0", "note": "日常"}
{"text": "幫我提醒明天下午要回診", "tier": "L0", "note": "工具型請求（回診本身非症狀）"}
{"text": "阿孫啊，你會不會唱歌？唱一首來聽聽", "tier": "L0", "note": "日常互動"}
{"text": "今天拜拜求平安，心裡踏實多了", "tier": "L0", "note": "日常"}
{"text": "腳踏車騎過頭，鐵腿了啦，哈哈", "tier": "L0", "note": "困難負例：運動痠痛，語氣輕鬆"}
