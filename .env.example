# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 長輩打字訊息走完整對話管線（危急偵測＋回覆＋記憶，✅ D-11）；預設開，關閉＝只收語音的逃生口
LINE_TEXT_INPUT_ENABLED=true
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 按用途覆寫模型（留空＝沿用 GEMINI_MODEL）；升級時危急分級優先（D-16）
GEMINI_MODEL_SAFETY=
GEMINI_MODEL_SUMMARY=
# Gemini API 呼叫逾時秒數
GEMINI_TIMEOUT_SECONDS=30

# 上網查證（Tavily）金鑰；免費額度每月 1000 次查詢。
# 留空＝不註冊 web_search 工具，金孫少一個上網查證能力，其餘功能照常。
TAVILY_API_KEY=

# TDX 運輸資料流通服務憑證（免費申請 https://tdx.transportdata.tw）。
# 兩者皆留空＝不註冊公車／捷運／停車工具（優雅降級）；路線工具走免金鑰的 OSRM，永遠可用。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ASR：dev 用 mock；接 DGX 真模型改 dgx 並填 endpoint
ASR_BACKEND=mock
# DGX 服務共用金鑰（設定後兩端須一致；留空＝內網不驗）
ASR_API_KEY=
ASR_ENDPOINT=
# ASR 逾時秒數，與下方 TTS_TIMEOUT_SECONDS 對稱
ASR_TIMEOUT_SECONDS=15
# TTS：dev/demo 用 bubble（文字泡泡）；接 DGX 真模型改 dgx 並填 endpoint
TTS_BACKEND=bubble
TTS_API_KEY=
TTS_ENDPOINT=
TTS_TIMEOUT_SECONDS=30
# 語音回覆形式：true＝語音＋文字；false＝只語音
TTS_REPLY_TEXT=true
# 短期記憶
MEMORY_MAX_TURNS=200
TIMEZONE=Asia/Taipei
# 長期記憶（Mem0 embedder 模型與骨幹整理排程）
LONGTERM_EMBEDDING_MODEL=gemini-embedding-001
# 情境 recall 時健康記憶的固定檢索條數（✅ 庚-38 接上 settings）
LONGTERM_HEALTH_TOP_K=3
# 每日記憶整理的小時（於 xx:05 執行；✅ 庚-48 預設 0＝00:05，凌晨盲窗縮到 5 分）
LONGTERM_CONSOLIDATION_HOUR=0
# 衛教 RAG
RAG_TOP_K=5
# 回答內容政策：allowed_only＝安全預設；classroom_demo＝課堂展示才可保留 needs_review／disallowed
RAG_CONTENT_POLICY=allowed_only
# 文件與查詢共用的 embedding 模型；release 固定記錄此模型與 768 維，禁止與長期記憶鍵混用
RAG_EMBEDDING_MODEL=gemini-embedding-001
# 獨立 RAG Worker 週更開關與 cron（預設每週日 03:00；false＝只待命、不更新）
RAG_REFRESH_ENABLED=false
RAG_REFRESH_CRON=0 3 * * 0
# release／ingestion 稽核保留天數；成功 release 永遠另依 active＋前兩版規則保留
RAG_AUDIT_RETENTION_DAYS=90
# 分庫 migrate 的唯讀來源庫；--in-place 模式不讀此鍵，分庫模式不得與 DATABASE_URL 相同
RAG_SOURCE_DATABASE_URL=
# ↓ RAG_CRAWLER_*／RAG_EMBEDDING_* 由 ingest／migrate／RAG Worker 直讀（✅ D-70），web app 不讀
# 每來源最大爬取頁數；須 ≥100 才抓得到衛教內文（20 只到列表頁，品質閘門過不了，2026-07-26 實測）
RAG_CRAWLER_MAX_PAGES=100
RAG_CRAWLER_DELAY_SECONDS=2
RAG_EMBEDDING_DELAY_SECONDS=6
# 單次 Gemini embedding HTTP 呼叫逾時秒數，避免外部服務無限卡住 Worker
RAG_EMBEDDING_TIMEOUT_SECONDS=60
# gemini-embedding-001 同步批次的 chunk 數；20 可避免巨型頁面單次請求過大
RAG_EMBEDDING_BATCH_SIZE=20
RAG_EMBEDDING_RETRIES=5
RAG_EMBEDDING_RETRY_INITIAL_DELAY_SECONDS=30
RAG_EMBEDDING_RETRY_MAX_DELAY_SECONDS=300
# 排程引擎
SCHEDULER_TICK_SECONDS=60
# 主動關懷
# 基準問候時間（幾點，0..23）；須落在 PROACTIVE_GREETING_EARLIEST_HOUR 與 LATEST_HOUR 之間
PROACTIVE_GREETING_HOUR=8
PROACTIVE_INACTIVITY_HOUR=10
PROACTIVE_INACTIVITY_DAYS=2
# ────── 每位長輩的問候時間（自適應；spec 2026-07-16） ──────
# 自適應問候時間總開關（spec 2026-07-16）；關閉則全體長輩回退 PROACTIVE_GREETING_HOUR。
# ⚠️ 改此值需重啟 worker 才生效（在 build_jobs 內求值，是建置期綁定，非每輪讀取）
PROACTIVE_GREETING_ADAPTIVE_ENABLED=true
# 回顧幾天的活躍紀錄來推算問候時間
PROACTIVE_GREETING_LOOKBACK_DAYS=14
# 至少幾天有活躍才調整；不足則不動（須 ≤ PROACTIVE_GREETING_LOOKBACK_DAYS）
PROACTIVE_GREETING_MIN_SAMPLE_DAYS=5
# 問候時間下限（幾點）；統計再怎麼算都不會早於此
PROACTIVE_GREETING_EARLIEST_HOUR=6
# 問候時間上限（幾點）；統計再怎麼算都不會晚於此
PROACTIVE_GREETING_LATEST_HOUR=11
# 單次最大調整幅度（分鐘，兩個方向共用），同時是往「前」調的死區門檻：她比現行問候
# 時間早這麼多以內就自己來，視為正常，不往前調。
# ⚠️ 必須是 30 的正倍數（30、60、90…），啟動時會驗證：問候時間一律對齊半點（問候 job
# 每半小時掃描），非倍數的步伐會被對齊吃掉或放大——設 ≤15 會被捨回原點（問候時間永遠
# 不動、自適應等同癱瘓），設 45 會往上進位（實際位移 60 分，超過你設的上限）。兩者都不報錯
PROACTIVE_GREETING_MAX_SHIFT_MINUTES=30
# 往「後」調的死區門檻（分鐘）：她在問候後多久內才有動靜都視為正常，不往後調。
# 與 MAX_SHIFT_MINUTES 分工——那個管「往前的死區與兩個方向的步伐」，這個只管「往後
# 的容忍」。刻意比 MAX_SHIFT 鬆（須 ≥ 它）：她在問候「前」就自己來是乾淨訊號（她確實
# 醒著），問候「後」才有動靜卻分不出「還沒醒」與「只是慢慢看手機」，故往後調要保守。
# 不受上面的 30 倍數限制：它只是門檻、不參與對齊，設 45 完全合法
PROACTIVE_GREETING_LAG_TOLERANCE_MINUTES=60
# 帳號綁定
INVITE_TTL_HOURS=24
INVITE_MAX_ATTEMPTS=5
# 雲端記憶層（Supabase Postgres / pgvector）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# 每進程連線池上限（✅ 庚-26）。連線總量公式：WEB_WORKERS×本值＋排程 worker×本值
# ≤ Supabase 直連上限（免費方案約 60）。預設下 WEB_WORKERS 安全上限約 8；
# 零星 CLI（記憶整理、RAG ingest）各再 +本值。注意：節流用 advisory lock，
# 不可換 6543 交易池化埠硬拉上限。
DATABASE_POOL_MAX_SIZE=5
LONGTERM_TOP_K=5
# 記憶檢索重排（LLM reranker，沿用 Gemini）；每次檢索多一次輕量 LLM 呼叫，額度吃緊可關
LONGTERM_RERANK_ENABLED=true
# 語音回覆音檔託管（Supabase Storage；TTS_BACKEND=dgx 時必填）
# service_role 金鑰：後台 Settings→API（非 DB 密碼）；需先建同名 Private bucket（✅ D-55 私有）
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
AUDIO_BUCKET=tts-audio
# 音檔本體保留天數（預設 2 天清理）；0＝不清理
AUDIO_RETENTION_DAYS=2
AUDIO_UPLOAD_TIMEOUT_SECONDS=10
# 音檔簽章連結有效期（秒；預設 1 天——檔案本身依 AUDIO_RETENTION_DAYS=2 天後刪除）
AUDIO_SIGNED_URL_EXPIRES_SECONDS=86400
# 對講機單回合音檔上限（bytes，預設 10MB）
AUDIO_MAX_UPLOAD_BYTES=10485760
# 危急分級信心門檻（0～1，三級制 ✅ D-72）：純 LLM 判 L2 信心低於 MID 降 L1（關鍵詞撐住的不降）；實測再調（會-7）
SAFETY_CONFIDENCE_MID=0.4
# 濫用審核總開關（2026-07-25）：擋角色綁架／洩漏系統設定／越權代工，命中不進 agent、直接回口語回絕話術。
# 預設 true（Leo 核定）。⚠️ 當初據以核定的評測數字已於同日作廢（LLM 裁判不可信，見 D-75），
# 目前尚無可信數字支撐，待重跑再定。未被推翻的是誤攔：8 題正常長輩發話對照組
#（含「我不想活了」「我胸口悶悶的」）直測審核器 8/8 全放行、零誤攔。
# 代價：每輪對話多一次 LLM 呼叫。設 false 為維運逃生口。
# 危急句在提示詞中明列一律放行，且審核一律排在家屬通知之後，開啟不影響 L2 通知。
SAFETY_MODERATION_ENABLED=true
# 攔截信心門檻（0～1）：判違規且信心達此值才攔，低於則放行。刻意高於 SAFETY_CONFIDENCE_MID（誤攔長輩代價更大）
SAFETY_MODERATION_MIN_CONFIDENCE=0.7
# 認證端點 per-IP 節流：視窗內超過次數回 429（登入／註冊／裝置綁定各自計數）
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# 帳號綁定流程（會話逾時，分鐘）
BINDING_SESSION_TTL_MINUTES=10
# 用藥提醒（時段鐘點）
MEDICATION_MORNING_HOUR=8
MEDICATION_NOON_HOUR=12
MEDICATION_EVENING_HOUR=18
MEDICATION_BEDTIME_HOUR=21
# 回診提醒（鐘點）
APPOINTMENT_REMINDER_HOUR=8
# ────── 統一排程（spec 2026-07-25） ──────
# 每位長輩的有效排程上限（防止誤判把行程表灌爆）
SCHEDULE_MAX_ACTIVE_PER_ELDER=20
# 到期判定窗（秒）；⚠ 非補發窗，只吸收每分鐘掃描的抖動，停機超過即作廢
SCHEDULE_DISPATCH_WINDOW_SECONDS=90
# 允許排到多久以後（天）
SCHEDULE_MAX_DAYS_AHEAD=365
# 家屬端 LIFF（LINE Login channel）
LIFF_CHANNEL_ID=
LIFF_TIMEOUT_SECONDS=10
# 家屬圖文選單（Rich Menu）
# LIFF_ID 僅供 python -m kinsun.channels.line.richmenu CLI 讀取，不經 config.py；需與 frontend/.env 的 VITE_LIFF_ID 填同一值
LIFF_ID=
RICH_MENU_ID=
# 觀測後台（開發團隊除錯用；金鑰留空＝停用 admin API）
ADMIN_API_KEY=
# 觀測資料（webhook／ASR／LLM／RAG／TTS／回覆六表）保留天數，逾期由排程清除
ADMIN_RETENTION_DAYS=14
# ────── 每晚反思與策略記憶（spec 2026-07-14） ──────
# 反思總開關；預設開（反思為每晚自動主線行為，本旗標僅供異常時緊急停用）
REFLECTION_ENABLED=true
# 反思每晚回顧幾天的對話與提醒紀錄（證據門檻需要跨多天視野）
REFLECTION_LOOKBACK_DAYS=7
# 一條守則至少要在幾天中被觀察到才成立；低於此值一律丟棄（擋掉單日噪音）。
# 須 ≤ REFLECTION_LOOKBACK_DAYS，否則應用啟動即失敗（config.py 有跨欄位驗證）：
# 證據門檻超出回顧視野時，沒有守則能通過門檻，反思會每晚空轉卻不報錯
REFLECTION_MIN_OBSERVED_DAYS=3
# 每位長輩生效中的守則上限，同時是注入 system prompt 的條數上限
REFLECTION_MAX_STRATEGIES=15
# 提醒發出後多久內長輩有發言即算「已回應」（分鐘）
REFLECTION_RESPONSE_WINDOW_MINUTES=60
# 反思單次讀取的對話輪數上限（涵蓋整個回顧窗，與聊天上下文的 MEMORY_MAX_TURNS 無關）；
# 超量時保留最新的輪次、丟棄最舊的，並記 warning
REFLECTION_MAX_TURNS=600
# ────── 話題新聞（spec 2026-07-20） ──────
# 新聞保留天數，逾期由排程清除（模式與 ADMIN_RETENTION_DAYS 相同）
NEWS_RETENTION_DAYS=14
# News API（newsapi.org）金鑰；留空＝不啟用該來源，僅剩衛福部（免金鑰）來源
NEWS_API_KEY=
# News API 查詢關鍵字（支援 OR／AND）：偏長輩聊得來的生活話題
NEWS_API_QUERY=健康 OR 天氣 OR 颱風 OR 美食 OR 旅遊 OR 節慶 OR 民生 OR 長者
# News API 來源白名單（逗號分隔網域，抓回後按文章網址過濾）：只收台灣來源、排除大陸；
# 條目＝完全相符或其子網域；留空＝不過濾（News API 索引未收台灣本土媒體，Yahoo 台灣版為主力）
NEWS_API_DOMAINS=tw.news.yahoo.com,tw.sports.yahoo.com
# RSS feed 清單（逗號分隔網址，免金鑰）：預設 Google News 台灣焦點＋生活話題搜尋（每則自帶實際台媒名）；留空＝不啟用 RSS
NEWS_RSS_FEEDS=https://news.google.com/rss?hl=zh-TW&gl=TW&ceid=TW:zh-Hant,https://news.google.com/rss/search?q=%E5%81%A5%E5%BA%B7%20OR%20%E5%A4%A9%E6%B0%A3%20OR%20%E7%BE%8E%E9%A3%9F%20OR%20%E7%AF%80%E6%85%B6%20OR%20%E9%95%B7%E8%80%85&hl=zh-TW&gl=TW&ceid=TW:zh-Hant
# 負面新聞排除關鍵字（逗號分隔）：標題或內文命中整則不給料；留空＝不過濾
NEWS_BLOCKED_KEYWORDS=兇殺,命案,殺人,分屍,性侵,虐童,自殺,輕生
# ────── 內部測試（spec 2026-07-12） ──────
# 內測模式總開關：開啟後 App 顯示「切換身分」、觀測後台開放手動觸發（經 GET /api/v1/meta 下發）
INTERNAL_TESTING_ENABLED=false
# debug：在文字泡泡最前面附上 ASR 辨識到的長者原話（內測建議 true，正式環境 false）
ASR_DEBUG_SHOW_TRANSCRIPT=false
# 綁定閘門：false＝未綁定也可對話（僅 demo／開發逃生口）；內測與正式都務必 true
BINDING_GATE_ENABLED=true
# ────── 長輩目前地點（LOCATION_ 前綴，spec 2026-07-17） ──────
# 位置超過幾小時就不再採信、金孫不會提地名。只影響主動問候：長輩講話時才抓位置，
# 對話中的位置必然是幾秒前的、一定新鮮。2＝保守（昨晚講的話，隔天早上的問候不提地點）。
LOCATION_STALE_AFTER_HOURS=2
# 內測標準組態＝語音全真：ASR_BACKEND=dgx＋TTS_BACKEND=dgx（與正式相同，見上方 ASR／TTS 區）
# 佈署用（app 不讀取，供 ngrok／啟動腳本）：authtoken 機密只放 .env，網域到 ngrok Domains 取得
NGROK_AUTHTOKEN=
NGROK_DOMAIN=xxxx-xxxx.ngrok-free.app
# ────── 測試（KINSUN_ 前綴＝測試／CI 旗標，app 不讀取） ──────
# Pg 整合測試總開關：1＝跑（需測試庫起著，起法見 scripts/test_db.sh up）、0＝整批 skip。
# 設 1 卻連不上測試庫時測試會直接紅——刻意不 skip，避免整合測試靜默跳過（庚-07 的教訓）。
KINSUN_IT=1
# 拋棄式測試庫連線串；與 CI 的 integration job 同一組設定。嚴禁與 DATABASE_URL 相同（✅ D-69）
KINSUN_TEST_DATABASE_URL=postgresql://postgres:kinsun-test@localhost:5433/postgres

# ────── 工程觀測 Opik（OPIK_ 前綴；工程/LLM 深度視角，與自建 observability 後台並存） ──────
# 總開關：預設 true 送 trace 到自架 Opik；連不到服務時會安靜降級為 no-op（見下）。
# 開發機（Windows/macOS）若不想跑 Opik，設 false 明確關閉即可。
OPIK_ENABLED=true
# 自架 Opik 後端位址（前端 nginx 反代 API）；DGX 本機自架見 /home/leo29/opik。
OPIK_URL_OVERRIDE=http://localhost:5273/api
# 自架工作區（單機自架預設 default）。
OPIK_WORKSPACE=default
# 專案名（Opik UI 內的分組標籤）。
OPIK_PROJECT_NAME=kinsun
# 啟用時的連線探測逾時（秒）：連不到 Opik 服務就在此秒數內判定並降級為 no-op，
# 避免無 Opik 環境（開發機／CI）被背景送 trace 的連線錯誤洗版。
OPIK_PING_TIMEOUT_SECONDS=2.0
