# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 長輩打字訊息走完整對話管線（危急偵測＋回覆＋記憶，✅ D-11）；預設開，關閉＝只收語音的逃生口
LINE_TEXT_INPUT_ENABLED=true
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 按用途覆寫模型（留空＝沿用 GEMINI_MODEL）；升級時危急分級優先（D-16）
GEMINI_MODEL_SAFETY=
GEMINI_MODEL_SUMMARY=
# Gemini API 呼叫逾時秒數
GEMINI_TIMEOUT_SECONDS=30

# 上網查證（Tavily）金鑰；免費額度每月 1000 次查詢。
# 留空＝不註冊 web_search 工具，金孫少一個上網查證能力，其餘功能照常。
TAVILY_API_KEY=

# ASR：dev 用 mock；接 DGX 真模型改 dgx 並填 endpoint
ASR_BACKEND=mock
# DGX 服務共用金鑰（設定後兩端須一致；留空＝內網不驗）
ASR_API_KEY=
ASR_ENDPOINT=
# ASR 逾時秒數，與下方 TTS_TIMEOUT_SECONDS 對稱
ASR_TIMEOUT_SECONDS=15
# TTS：dev/demo 用 bubble（文字泡泡）；接 DGX 真模型改 dgx 並填 endpoint
TTS_BACKEND=bubble
TTS_API_KEY=
TTS_ENDPOINT=
TTS_TIMEOUT_SECONDS=30
# 語音回覆形式：true＝語音＋文字；false＝只語音
TTS_REPLY_TEXT=true
# 短期記憶
MEMORY_MAX_TURNS=200
TIMEZONE=Asia/Taipei
# 長期記憶（Mem0 embedder 模型與骨幹整理排程）
LONGTERM_EMBEDDING_MODEL=gemini-embedding-001
# 情境 recall 時健康記憶的固定檢索條數（✅ 庚-38 接上 settings）
LONGTERM_HEALTH_TOP_K=3
# 每日記憶整理的小時（於 xx:05 執行；✅ 庚-48 預設 0＝00:05，凌晨盲窗縮到 5 分）
LONGTERM_CONSOLIDATION_HOUR=0
# 衛教 RAG
RAG_TOP_K=5
# ↓ RAG_CRAWLER_*／RAG_EMBEDDING_* 僅離線 ingest CLI 直讀（✅ D-70），app 不讀
RAG_CRAWLER_MAX_PAGES=20
RAG_CRAWLER_DELAY_SECONDS=2
RAG_EMBEDDING_DELAY_SECONDS=6
RAG_EMBEDDING_RETRIES=5
RAG_EMBEDDING_RETRY_INITIAL_DELAY_SECONDS=30
RAG_EMBEDDING_RETRY_MAX_DELAY_SECONDS=300
# 排程引擎
SCHEDULER_TICK_SECONDS=60
# 主動關懷
PROACTIVE_GREETING_HOUR=8
PROACTIVE_INACTIVITY_HOUR=10
PROACTIVE_INACTIVITY_DAYS=2
# 帳號綁定
INVITE_TTL_HOURS=24
INVITE_MAX_ATTEMPTS=5
# 雲端記憶層（Supabase Postgres / pgvector）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# 每進程連線池上限（✅ 庚-26）。連線總量公式：WEB_WORKERS×本值＋排程 worker×本值
# ≤ Supabase 直連上限（免費方案約 60）。預設下 WEB_WORKERS 安全上限約 8；
# 零星 CLI（記憶整理、RAG ingest）各再 +本值。注意：節流用 advisory lock，
# 不可換 6543 交易池化埠硬拉上限。
DATABASE_POOL_MAX_SIZE=5
LONGTERM_TOP_K=5
# 記憶檢索重排（LLM reranker，沿用 Gemini）；每次檢索多一次輕量 LLM 呼叫，額度吃緊可關
LONGTERM_RERANK_ENABLED=true
# 語音回覆音檔託管（Supabase Storage；TTS_BACKEND=dgx 時必填）
# service_role 金鑰：後台 Settings→API（非 DB 密碼）；需先建同名 Private bucket（✅ D-55 私有）
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
AUDIO_BUCKET=tts-audio
# 音檔本體保留天數（預設 2 天清理）；0＝不清理
AUDIO_RETENTION_DAYS=2
AUDIO_UPLOAD_TIMEOUT_SECONDS=10
# 音檔簽章連結有效期（秒；預設 1 天——檔案本身依 AUDIO_RETENTION_DAYS=2 天後刪除）
AUDIO_SIGNED_URL_EXPIRES_SECONDS=86400
# 對講機單回合音檔上限（bytes，預設 10MB）
AUDIO_MAX_UPLOAD_BYTES=10485760
# 危急分級信心門檻（0～1，三級制 ✅ D-72）：純 LLM 判 L2 信心低於 MID 降 L1（關鍵詞撐住的不降）；實測再調（會-7）
SAFETY_CONFIDENCE_MID=0.4
# 認證端點 per-IP 節流：視窗內超過次數回 429（登入／註冊／裝置綁定各自計數）
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# 帳號綁定流程（會話逾時，分鐘）
BINDING_SESSION_TTL_MINUTES=10
# 用藥提醒（時段鐘點）
MEDICATION_MORNING_HOUR=8
MEDICATION_NOON_HOUR=12
MEDICATION_EVENING_HOUR=18
MEDICATION_BEDTIME_HOUR=21
# 回診提醒（鐘點）
APPOINTMENT_REMINDER_HOUR=8
# 家屬端 LIFF（LINE Login channel）
LIFF_CHANNEL_ID=
LIFF_TIMEOUT_SECONDS=10
# 家屬圖文選單（Rich Menu）
# LIFF_ID 僅供 python -m kinsun.channels.line.richmenu CLI 讀取，不經 config.py；需與 frontend/.env 的 VITE_LIFF_ID 填同一值
LIFF_ID=
RICH_MENU_ID=
# 觀測後台（開發團隊除錯用；金鑰留空＝停用 admin API）
ADMIN_API_KEY=
# 觀測資料（webhook／ASR／LLM／TTS／回覆五表）保留天數，逾期由排程清除
ADMIN_RETENTION_DAYS=14
# ────── 內部測試（spec 2026-07-12） ──────
# 內測模式總開關：開啟後 App 顯示「切換身分」、觀測後台開放手動觸發（經 GET /api/v1/meta 下發）
INTERNAL_TESTING_ENABLED=false
# debug：在文字泡泡最前面附上 ASR 辨識到的長者原話（內測建議 true，正式環境 false）
ASR_DEBUG_SHOW_TRANSCRIPT=false
# 綁定閘門：false＝未綁定也可對話（僅 demo／開發逃生口）；內測與正式都務必 true
BINDING_GATE_ENABLED=true
# 內測標準組態＝語音全真：ASR_BACKEND=dgx＋TTS_BACKEND=dgx（與正式相同，見上方 ASR／TTS 區）
# 佈署用（app 不讀取，供 ngrok／啟動腳本）：authtoken 機密只放 .env，網域到 ngrok Domains 取得
NGROK_AUTHTOKEN=
NGROK_DOMAIN=xxxx-xxxx.ngrok-free.app
# ────── 測試（KINSUN_ 前綴＝測試／CI 旗標，app 不讀取） ──────
# Pg 整合測試總開關：1＝跑（需測試庫起著，起法見 scripts/test_db.sh up）、0＝整批 skip。
# 設 1 卻連不上測試庫時測試會直接紅——刻意不 skip，避免整合測試靜默跳過（庚-07 的教訓）。
KINSUN_IT=1
# 拋棄式測試庫連線串；與 CI 的 integration job 同一組設定。嚴禁與 DATABASE_URL 相同（✅ D-69）
KINSUN_TEST_DATABASE_URL=postgresql://postgres:kinsun-test@localhost:5433/postgres
