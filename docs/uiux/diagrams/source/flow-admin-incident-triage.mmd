flowchart TD
  subgraph L0["偵測"]
    L0N0["起點：總覽輪詢"]
    L0N1["決策：出現告警或錯誤？"]
    L0N0 --> L0N1
    L0N2["操作：進訊息流或長輩"]
    L0N1 --> L0N2
  end
  subgraph L1["定位"]
    L1N0["畫面：單日時間軸"]
    L1N1["操作：開啟 trace"]
