title: User Flow 02：長輩 QR／手動碼綁定
---
flowchart TD
  subgraph L0["操作"]
    L0N0["起點：選擇長輩"]
    L0N1["畫面：綁定方式"]
    L0N0 --> L0N1
    L0N2["操作：掃 QR 或輸入碼"]
    L0N1 --> L0N2
  end
  subgraph L1["系統"]
    L1N0["決策：相機已允許？"]
    L1N1["系統：送出綁定碼"]
