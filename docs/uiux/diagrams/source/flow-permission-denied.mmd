---
title: User Flow 05：麥克風或定位權限遭拒
---
flowchart TD
  subgraph L0["請求"]
    L0N0["起點：首次進入對話"]
    L0N1["系統：先請麥克風"]
    L0N0 --> L0N1
    L0N2["系統：再請定位"]
    L0N1 --> L0N2
  end
  subgraph L1["決策"]
    L1N0["決策：麥克風允許？"]
    L1N1["錯誤：拒絕則不能錄音"]
    L1N0 --> L1N1
    L1N2["決策：定位允許？"]
    L1N1 --> L1N2
    L1N3["空狀態：拒絕仍可對話"]
    L1N2 --> L1N3
  end
  L0N2 -.-> L1N0
  subgraph L2["回復"]
    L2N0["回復：開啟系統設定"]
    L2N1["回復：重新檢查權限"]
    L2N0 --> L2N1
    L2N2["成功：麥克風可用"]
    L2N1 --> L2N2
    L2N3["取消：稍後再試或登出"]
    L2N2 --> L2N3
  end
  L1N3 -.-> L2N0
