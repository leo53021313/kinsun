---
title: User Flow 04：長輩語音對話完整流程
---
flowchart TD
  subgraph L0["錄音"]
    L0N0["起點：Idle"]
    L0N1["操作：按住或短按麥克風"]
    L0N0 --> L0N1
    L0N2["系統：觸覺與音效開始"]
    L0N1 --> L0N2
    L0N3["操作：放開或再按一次停止"]
    L0N2 --> L0N3
  end
  subgraph L1["處理"]
    L1N0["畫面：Listening"]
    L1N1["系統：WS 上傳音訊與可選定位"]
    L1N0 --> L1N1
    L1N2["畫面：Thinking"]
    L1N1 --> L1N2
    L1N3["決策：ack／reply／error？"]
    L1N2 --> L1N3
  end
  L0N3 -.-> L1N0
  subgraph L2["結果"]
    L2N0["ack：Speaking 後回 Thinking"]
    L2N1["reply：最後一段後回 Idle"]
    L2N0 --> L2N1
    L2N2["純文字 reply：抵達即回 Idle"]
    L2N1 --> L2N2
    L2N3["error：高對比 Error"]
    L2N2 --> L2N3
    L2N4["降級：POST turns"]
    L2N3 --> L2N4
    L2N5["回復：再次使用麥克風"]
    L2N4 --> L2N5
  end
  L1N3 -.-> L2N0
