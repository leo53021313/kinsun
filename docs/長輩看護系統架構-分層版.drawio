        <mxCell id="note-lang" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;語言流（重要）&lt;/b&gt;&lt;div&gt;全程文字＝繁體中文漢字；台語只發生在 TTS 聲學層。台語 TTS 於另一專案微調中（CosyVoice 3 vs VoxCPM2 對比，8 月初出結論）。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="40" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="note-mem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;記憶讀寫（即時讀寫＋夜間批次）&lt;/b&gt;&lt;div&gt;①對話前 recall 聚合三層（今日對話＋長期記憶＋事實）餵 LLM ②每輪即時寫短期記憶 ③夜間批次把前一天對話抽取進 Mem0 長期記憶。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="390" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="note-proactive" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;主動關懷（長照核心）&lt;/b&gt;&lt;div&gt;排程器定時觸發：問候、用藥/回診提醒、久未互動主動關心；出站訊息經 channels 送 App／LINE。讓系統不只『被動回答』。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="750" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="note-front" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;前端互動（主通道＝金孫 App）&lt;/b&gt;&lt;div&gt;對講機按住說話、一來一往非串流，不需 VAD/串流/打斷；LINE 通道凍結僅服務存量；未來做即時語音再補串流。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="310" x="1110" y="1570" as="geometry" />
        </mxCell>
