      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1-title" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="金孫 App 資訊架構｜分頁 1：頁面地圖（現況 8 頁＋規劃中）">
