        <mxCell id="t1-bind" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;長輩綁定碼登入&lt;/b&gt;&lt;br&gt;&lt;i&gt;/elder/bind&lt;/i&gt;&lt;br&gt;大字輸入家屬給的號碼">
