        <mxCell id="t1-zoneElder" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#d79b00;fontColor=#d79b00;" value="長輩端">
          <mxGeometry x="90" y="300" width="280" height="310" as="geometry" />
        </mxCell>
        <mxCell id="t1-zoneGuardian" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#82b366;fontColor=#82b366;" value="家屬端">
          <mxGeometry x="610" y="300" width="470" height="440" as="geometry" />
        </mxCell>
        <mxCell id="t1-entry" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;入口導向（無畫面）&lt;/b&gt;&lt;br&gt;&lt;i&gt;/&lt;/i&gt;&lt;br&gt;讀取儲存的 session 自動跳轉">
          <mxGeometry x="460" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t1-role" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;選角色&lt;/b&gt;&lt;br&gt;&lt;i&gt;/role&lt;/i&gt;&lt;br&gt;我是長輩／我是家屬">
